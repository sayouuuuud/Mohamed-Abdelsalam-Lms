{
  "name": "transcoder-worker",
  "version": "1.0.0",
  "description": "FFmpeg HLS transcoding worker for the LMS platform",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
