# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# ─── Cloudflare R2 ────────────────────────────────────────────────
R2_ACCOUNT_ID=abc123
R2_ACCESS_KEY_ID=key_id
R2_SECRET_ACCESS_KEY=secret_key
R2_BUCKET=lms-videos
R2_ENDPOINT=https://abc123.r2.cloudflarestorage.com

# ─── Worker identity (اختياري، للـ claim_video_job) ──────────────
WORKER_ID=worker-1

# ─── وضع التشغيل ─────────────────────────────────────────────────
# "poll" = polling دائم (always-on)
# "http" = HTTP server ينتظر إشارة الصحيان (scale-to-zero)
WORKER_MODE=http

# ─── HTTP server ─────────────────────────────────────────────────
PORT=4000
WORKER_WAKE_SECRET=some_secret_here

# ─── Polling interval (لو WORKER_MODE=poll) ──────────────────────
POLL_INTERVAL_MS=10000

# ─── مسار FFmpeg (اختياري، الافتراضي: ffmpeg في PATH) ────────────
# FFMPEG_PATH=/usr/bin/ffmpeg
