# ─────────────────────────────────────────────────────────────
# Coolify Postgres (Prisma) — added in the Supabase → Prisma migration
# ─────────────────────────────────────────────────────────────

# Runtime queries from the running app.
# On Coolify use the INTERNAL Docker network hostname (service name), e.g.
#   postgresql://USER:PASSWORD@<coolify-postgres-service>:5432/DB
# This stays on the private network — fast and never exposed publicly.
DATABASE_URL=

# Direct connection used by `prisma migrate` / `prisma db pull` and local dev.
# This is the EXTERNALLY reachable host:port Coolify exposes, e.g.
#   postgresql://USER:PASSWORD@your-vps-host:5432/DB
# Prisma needs this so migrations don't run through a pooler/internal-only host.
DIRECT_URL=

# ─────────────────────────────────────────────────────────────
# NextAuth (Auth.js v5) — added in the migration
# ─────────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical app URL (e.g. https://lms.example.com). Locally: http://localhost:3000
AUTH_URL=

# ─────────────────────────────────────────────────────────────
# Email (activation codes) — already used by the current register flow
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────────────────────────────────────
# Storage — UploadThing + Cloudflare R2 (already in use)
# ─────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─────────────────────────────────────────────────────────────
# LEGACY — Supabase. Kept ONLY for rollback safety until Milestone 7.
# Do not build new code against these; they will be removed at cutover.
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
